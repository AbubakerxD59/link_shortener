APP_NAME="ShrtLnk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Branded custom domains (logged-in users)
# Subdomain: go.yourbrand.com  CNAME  name=go   →  CUSTOM_DOMAIN_CNAME_TARGET
# Main domain: yourbrand.com    CNAME  name=@   →  CUSTOM_DOMAIN_CNAME_TARGET
# DNS verification is not enough — each branded host needs HTTPS (see docs/BRANDED_DOMAIN_SSL.md)
# CUSTOM_DOMAIN_SCHEME=https
# CUSTOM_DOMAIN_CNAME_TARGET=cname.yourshortener.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=engagyo_link_shortener
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Engagyo shared database (optional — use same short_links table as Engagyo)
ENGAGYO_USE_SHARED_DB=false
ENGAGYO_DB_CONNECTION=engagyo
ENGAGYO_DB_HOST=127.0.0.1
ENGAGYO_DB_PORT=3306
ENGAGYO_DB_DATABASE=engagyo
ENGAGYO_DB_USERNAME=root
ENGAGYO_DB_PASSWORD=
ENGAGYO_APP_URL=http://localhost
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
